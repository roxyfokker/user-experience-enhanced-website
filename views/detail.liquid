{% render 'layouts/base.liquid' %}
{% block content %}
    <main>
        <article>
            <div class="decor-block"></div>
            <section class="instrument-header">
                <div class="instrument-header-text">
                    <h1>{{ instruments.name }}</h1>
                    <p>{{ instruments.serial_number | default: 'Onbekend' }}</p>
                </div>
                <span class="labell
                    {% if status == 'Beschikbaar' %}status-available
                    {% elsif status == 'In reparatie' %}status-repair
                    {% elsif status == 'Uitgeleend' or status == 'In gebruik voor school' %}status-borrowed
                    {% else %}status-unknown
                    {% endif %}
                    ">
                    {% if status == 'Beschikbaar' %}
                        Beschikbaar 
                    {% elsif status == 'In reparatie' %}
                        In Reparatie 
                    {% elsif status == 'Uitgeleend' %}
                        Uitgeleend 
                    {% elsif status == 'In gebruik voor school' %}
                        In Gebruik voor school
                    {% else %}
                        Onbekend
                    {% endif %}
                </span>
            </section>
        
            <a href="https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?width=1600&quality=85" target="_blank" class="lightbox-trigger">
                <picture>
                    <source type="image/avif" 
                        srcset="https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?format=avif&width=400&quality=70 400w,
                                https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?format=avif&width=800&quality=70 800w,
                                https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?format=avif&width=1200&quality=70 1200w"
                        sizes="(max-width: 600px) 400px, (max-width: 1024px) 800px, 1200px"
                    >
                    <source type="image/webp" 
                        srcset="https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?format=webp&width=400&quality=70 400w,
                                https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?format=webp&width=800&quality=70 800w,
                                https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?format=webp&width=1200&quality=70 1200w"
                        sizes="(max-width: 600px) 400px, (max-width: 1024px) 800px, 1200px"
                    >
                    <img 
                        src="https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?width=800&quality=70"
                        srcset="https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?width=400&quality=70 400w,
                                https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?width=800&quality=70 800w,
                                https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?width=1200&quality=70 1200w"
                        sizes="(max-width: 600px) 400px, (max-width: 1024px) 800px, 1200px"
                        width="{{ instruments.photo.width }}" 
                        height="{{ instruments.photo.height }}"
                        alt="{{ instruments.name }}"
                    >                
                </picture>
            </a>

            <section class="instrument-info">
                <dl>
                    <dt>Merk:</dt>
                    <dd>{{ instruments.brand | default: "Onbekend" }}</dd>

                    <dt>Type:</dt>
                    <dd>{{ type | default: "Onbekend"}}</dd>

                    <dt>Locatie:</dt>
                    <dd>{{ instruments.storage_room | default: "Onbekend" }}</dd>

                    <dt>Eigendom:</dt>
                    <dd>{{ instruments.property | default: "Onbekend" }}</dd>
                </dl>
            </section>

            <section class="instrument-action">
                {% if instruments.status == 'Beschikbaar' %}
                    <a href="">Uitlenen</a> 
                {% else %}
                    <a href="">Innemen</a>
                {% endif %}
                <a href="">Schade melden</a>
            </section>
            
            
            <section class="instrument-info-more">
                <details>
                    <summary>Beschrijving</summary>
                    <p>{{ instruments.details | default: "Onbekend" }}</p>
                </details>
                <details class="met-data">
                    <summary>Uitgeleend</summary>
                    <dl>
                        <dt>Uitgeleent aan:</dt>
                        <dd>Pietje Puck</dd>

                        <dt>Uitgeleent vanaf:</dt>
                        <dd>Maart 2025</dd>
                    </dl>
                </details>
                <details>
                    <!--Hier komt nog wat anders placeholder-->
                    <summary>Beheer / actie geschiednis</summary>
                    <ul>
                        <li><time datetime="2026-03-30">30 maart 2026</time> — Schade gemeld</li>
                        <li><time datetime="2026-03-28">28 maart 2026</time> — Ingenomen</li>
                        <li><time datetime="2026-03-20">20 maart 2026</time> — Uitgeleend</li>
                    </ul>
                </details>
            </section>
            
           
        </article>
    </main>
{% endblock %}