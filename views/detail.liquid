{% render 'layouts/base.liquid' %}
{% block content %}
    <main>
        <article>
            <section class="hero">
                <picture>
                    <source type="image/avif" srcset="https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?format=avif">
                    <source type="image/webp" srcset="https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}?format=webp">
                    <img 
                        src="https://fdnd-agency.directus.app/assets/{{ instruments.photo.id }}"
                        width="{{ instruments.photo.width }}" 
                        height="{{ instruments.photo.height }}"
                        alt="{{ instruments.name }}"
                    >
                </picture>
            </section>
           <h1>{{ instruments.name }}</h1>
        </article>
    </main>
{% endblock %}