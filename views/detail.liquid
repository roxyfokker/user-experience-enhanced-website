{% render 'layouts/base.liquid' %}
{% block content %}
    <main>
        <article>
            <section class="hero">
                <picture>
                    <source type="image/avif" srcset="https://fdnd-agency.directus.app/assets/{{ instruments.photo }}?format=avif">
                    <source type="image/webp" srcset="https://fdnd-agency.directus.app/assets/{{ instruments.photo }}?format=webp">
                    <img src="https://fdnd-agency.directus.app/assets/{{ instruments.photo }}" alt="{{ instruments.name }}">
                </picture>
            </section>
           <h1>{{ instruments.name }}</h1>
        </article>
    </main>
{% endblock %}