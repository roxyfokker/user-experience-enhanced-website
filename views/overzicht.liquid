{% render 'layouts/base.liquid' %}
{% block content %}
<main class="instrument-overview-main">
    <h2>Overzicht van de instrumenten</h2>
    {% if successName %}
        <div class="melding-success">
            <img src="/icons/available.svg" alt="">
            <div>
                <p>Opslaan is gelukt !</p>
                <p>{{ SuccessName }} is toegevoegd aan het overzicht </p>
            </div>
        </div>
    {% endif %}

    <section class="overview-toolbar">
        <form action="/instrumenten" method="get">
            <div class="searchbar">
                <input id="zoekbalk" placeholder="zoeken" type="text" name="zoek" value="{{ zoekterm }}">
                <button class="btn"></button>
            </div>
            <select class="filter" name="status" onchange="this.form.submit()">
                <option value="">Alle statussen</option>
                <option value="Beschikbaar"  {% if status == 'Beschikbaar'  %}selected{% endif %}>Beschikbaar</option>
                <option value="Uitgeleend"   {% if status == 'Uitgeleend'   %}selected{% endif %}>Uitgeleend</option>
                <option value="In reparatie" {% if status == 'In reparatie' %}selected{% endif %}>In reparatie</option>
            </select>
        </form>
        <button class="btn">Nieuw instrument toevoegen</button>
    </section>

 
    <section class="instrument-table-section">
        <p>{{ aantalResultaten }} resultaten gevonden instrumenten gevonden</p>
            <table class="instrument-table">
                <thead>
                    <tr>
                        <th scope="col">
                            Naam instrument
                            <a  href="?sort={% if sort == 'name' %}-name{% else %}name{% endif %}&status={{ status }}&zoek={{ zoekterm }}" 
                                data-sort="{% if sort == 'name' %}asc{% elsif sort == '-name' %}desc{% endif %}">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="24" height="24">
                                    <path class="pijl-omlaag" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" 
                                        d="M6 16h12m0 0 -4.125 -4M18 16l-4.125 4" stroke-width="1.5"/>
                                    <path class="pijl-omhoog" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" 
                                        d="M18 8H6m0 0 4.125 -4M6 8l4.125 4" stroke-width="1.5"/>
                                </svg>
                            </a>
                        </th>
                        <th scope="col">
                            Serienummer
                            <a  href="?sort={% if sort == 'serial_number' %}-serial_number{% else %}serial_number{% endif %}&status={{ status }}&zoek={{ zoekterm }}"
                                data-sort="{% if sort == 'serial_number' %}asc{% elsif sort == '-serial_number' %}desc{% endif %}">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="24" height="24">
                                    <path class="pijl-omlaag" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" 
                                        d="M6 16h12m0 0 -4.125 -4M18 16l-4.125 4" stroke-width="1.5"/>
                                    <path class="pijl-omhoog" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" 
                                        d="M18 8H6m0 0 4.125 -4M6 8l4.125 4" stroke-width="1.5"/>
                                </svg>
                            </a>
                        </th>
                        <th scope="col">Type</th>
                        <th scope="col">Merk</th>
                        <th scope="col">Eigendom van</th>
                        <th scope="col">
                            Status
                            <a  href="?sort={% if sort == 'status' %}-status{% else %}status{% endif %}&status={{ status }}&zoek={{ zoekterm }}"
                                data-sort="{% if sort == 'status' %}asc{% elsif sort == '-status' %}desc{% endif %}">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="24" height="24">
                                    <path class="pijl-omlaag" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" 
                                        d="M6 16h12m0 0 -4.125 -4M18 16l-4.125 4" stroke-width="1.5"/>
                                    <path class="pijl-omhoog" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" 
                                        d="M18 8H6m0 0 4.125 -4M6 8l4.125 4" stroke-width="1.5"/>
                                </svg>
                            </a>
                        </th> 
                        <th scope="col">Link</th> 
                    </tr>
                </thead>
                <tbody>
                    {% if instruments.size == 0 %}
                        <tr class="empty-row">
                            <td class="empty-data" colspan="7">
                                {% if request.params.type != blank %}
                                    <p>Je hebt nog geen instrumenten toegevoegd</p>
                                    <p>Begin met het toevoegen van je eerste instrument.</p>
                                    <button class="primary-button">+ Instrument toevoegen</button>
                                {% else %}
                                    <p>Geen instrumenten gevonden</p>
                                    <p>Er zijn nog geen instrumenten binnen deze categorie. "{{ type }}".</p>
                                    <a href="/instrumenten" class="secondary-button">Bekijk alle instrumenten</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        {% for instrument in instruments %}
                            <tr id="{{ instrument.key }}">
                                <td  scope="row">{{ instrument.name }}</td>
                                <td>{{ instrument.serial_number | default: "Onbekend" }}</td>
                                <td>{{ instrument.type          | default: "Onbekend" }}</td>
                                <td>{{ instrument.brand         | default: "Onbekend" }}</td>
                                <td>{{ instrument.property      | default: "Onbekend" }}</td>
                                <td>
                                    <span class="labell
                                        {% if status == 'Beschikbaar' %}status-available
                                        {% elsif status == 'In reparatie' %}status-repair
                                        {% elsif status == 'Uitgeleend' or status == 'In gebruik voor school' %}status-borrowed
                                        {% else %}status-unknown
                                        {% endif %}
                                    ">
                                        {% if status == 'Beschikbaar' %}
                                            Beschikbaar 
                                        {% elsif status == 'In reparatie' %}
                                            In Reparatie 
                                        {% elsif status == 'Uitgeleend' %}
                                            Uitgeleend 
                                        {% elsif status == 'In gebruik voor school' %}
                                            In Gebruik voor school
                                        {% else %}
                                            Onbekend
                                        {% endif %}
                                    </span>
                                </td>
                                <td><a class="table-link" href="/instrumenten/{{ instrument.id }}">detail</a></td>
                                {% comment %}
                                <td>
                                    <form action="/instrumenten/delete" method="POST">
                                        <input type="hidden" name="id" value="{{ instrument.id }}">
                                        <button type="submit">Verwijder</button>
                                    </form>
                                </td>
                                {% endcomment %}
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
    </section>

</main>

{% endblock %}