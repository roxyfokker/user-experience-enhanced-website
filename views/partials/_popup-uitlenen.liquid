<dialog id="uitlenen-dialog">

    <section class="popup-header">
        <h2>Instrument Uitlenen</h2>
        <button class="popup-sluiten" onclick="document.getElementById('popup-menu').close()"><img src="/assets/icons/close.svg" alt=""></button>
    </section>
    <section class="popup-banner">
        {% comment %} slechte naam/div word picture {% endcomment %}
        <div class="banner-picture"></div>
        <div class="banner-text">
            <p>{{ instrument.name }}</p>
            <p>{{ instrument.serial_number | default: 'onbekend'}}</p>
        </div>

        <span class="status-label
                    {% if status == 'Beschikbaar' %}status-available
                    {% elsif status == 'In reparatie' %}status-repair
                    {% elsif status == 'Uitgeleend' or status == 'In gebruik voor school' %}status-borrowed
                    {% else %}status-unknown
                    {% endif %}
                    ">
                    {% if status == 'Beschikbaar' %}
                        Beschikbaar 
                    {% elsif status == 'In reparatie' %}
                        In Reparatie 
                    {% elsif status == 'Uitgeleend' %}
                        Uitgeleend 
                    {% elsif status == 'In gebruik voor school' %}
                        In Gebruik voor school
                    {% else %}
                        Onbekend
                    {% endif %}
        </span>
    </section>

    <form action="/instrumenten/{{ instrument.id }}/uitlenen" method="POST">

        <input type="hidden" name="status" value="Uitgeleend">
        <input type="hidden" name="rented_from" value="{{ 'now' | date: '%Y-%m-%dT%H:%M:%S' }}">
        <input type="hidden" name="action_type" value="Uitlenen">
        <label>
            Door wie word het instrument uitgeleent ?
            <input type="text" name="performed_by" placeholder="Naam Docent" required>
        </label>

        <label>Uitgeleend aan: *
            <input type="text" name="student_name" placeholder="bijv. Jan de Vries" required>
        </label>

        <label>
            Opmerking:
            <input type="text" name="note" placeholder="Opmerkingen">
        </label>

        <button class="btn btn-secondary" onclick="document.getElementById('uitlenen-dialog').close()">Annuleren</button>
        <button class="btn btn-primary" type="submit">Instrument Uitlenen</button>

    </form>

</dialog>