<dialog id="popup-menu">
    <section class="popup-header">
        <h2>Wat wil je met het instrument doen ?</h2>
        <button class="popup-sluiten" onclick="document.getElementById('popup-menu').close()"><img src="/assets/icons/close.svg" alt=""></button>
    </section>
    <section class="popup-banner">
        {% comment %} slechte naam/div word picture {% endcomment %}
        <div class="banner-picture"></div>
        <div class="banner-text">
            <p>{{ instrument.name }}</p>
            <p>{{ instrument.serial_number | default: 'onbekend'}}</p>
        </div>

        <span class="status-label
            {% if status == 'Beschikbaar' %}status-available
            {% elsif status == 'In reparatie' %}status-repair
            {% elsif status == 'Uitgeleend' or status == 'In gebruik voor school' %}status-borrowed
            {% else %}status-unknown
            {% endif %}">
            
            {% if status == 'Beschikbaar' %}
                Beschikbaar 
            {% elsif status == 'In reparatie' %}
                In Reparatie 
            {% elsif status == 'Uitgeleend' %}
                Uitgeleend 
            {% elsif status == 'In gebruik voor school' %}
                In Gebruik voor school
            {% else %}
                Onbekend
            {% endif %}
        </span>
    </section>

    <section class="action-btns" role="group" aria-label="Instrumenten acties">

        {% comment %} Als instrument onbekend
        <button class="btn btn-primary" onclick="document.getElementById('toevoegen-dialog').showModal()">Instrument toevoegen</button>
            {% render 'partials/_popup-innemen.liquid' %}
        {% endcomment %}


        {% if status == 'Beschikbaar' %}
            <button class="btn btn-primary" onclick="document.getElementById('uitlenen-dialog').showModal()">
               <svg width="16" height="18" viewBox="0 0 16 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6.11929 16.6136H2.70643C2.28145 16.6428 1.86369 16.4769 1.54409 16.152C1.22449 15.8271 1.02893 15.3695 1 14.8788V2.73808C1.02893 2.24741 1.22449 1.7898 1.54409 1.4649C1.86369 1.13999 2.28145 0.974097 2.70643 1.00333H6.11929" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M10.7332 12.6701L15 8.8114L10.7332 4.94679" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M15 8.80804H4.75995" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Uitlenen
            </button>
            {% render 'partials/_popup-uitlenen.liquid' instrument: instrument status: status%}


        {% elsif status == 'Uitgeleend' or status == 'In gebruik voor school' or status == 'In reparatie' %}
            <button class="btn btn-primary" onclick="document.getElementById('innemen-dialog').showModal()">
                <svg width="20" height="16" viewBox="0 0 20 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5.8 14.7143L1 10.1429L5.8 5.57143M1 10.1429H14.2C15.473 10.1429 16.6939 9.66123 17.5941 8.80392C18.4943 7.94661 19 6.78385 19 5.57143C19 4.35901 18.4943 3.19625 17.5941 2.33894C16.6939 1.48163 15.473 1 14.2 1H13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Innemen
            </button>
            {% render 'partials/_popup-innemen.liquid' instrument: instrument status: status%}
        {% endif %}


        {% comment %} Ongeacht de status {% endcomment %}
        <button class="btn btn-secondary" onclick="document.getElementById('schade-dialog').showModal()">
            <svg xmlns="http://www.w3.org/2000/svg" width="17.545" height="15.425" viewBox="0 0 17.545 15.425">
                <g id="Group_58" data-name="Group 58" transform="translate(1.023 1)">
                    <path id="Path_8" data-name="Path 8" d="M7.45,2.525,1.169,13.011a1.483,1.483,0,0,0,1.268,2.225H15a1.483,1.483,0,0,0,1.268-2.225L9.986,2.525a1.483,1.483,0,0,0-2.536,0Z" transform="translate(-0.97 -1.811)" fill="none" stroke="#fb0" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                    <path id="Path_9" data-name="Path 9" d="M7.5,5.625V8.591" transform="translate(0.248 -1.1)" fill="none" stroke="#fb0" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                    <path id="Path_10" data-name="Path 10" d="M7.5,10.625h.007" transform="translate(0.248 -0.166)" fill="none" stroke="#fb0" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                </g>
            </svg>
            Schade melden
        </button>
        {% render 'partials/_popup-schade-melden.liquid' instrument: instrument status: status%}
            

        <button class="btn btn-secondary" onclick="document.getElementById('schade-dialog').showModal()">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.5 0C10.1811 0 11.8245 0.498516 13.2223 1.43251C14.6202 2.3665 15.7096 3.69402 16.353 5.24719C16.9963 6.80036 17.1646 8.50943 16.8367 10.1583C16.5087 11.8071 15.6992 13.3217 14.5104 14.5104C13.3217 15.6992 11.8071 16.5087 10.1583 16.8367C8.50943 17.1646 6.80036 16.9963 5.24719 16.353C3.69402 15.7096 2.3665 14.6202 1.43251 13.2223C0.498516 11.8245 0 10.1811 0 8.5C0.000180682 6.24571 0.895772 4.08381 2.48979 2.48979C4.08381 0.895772 6.24571 0.000180682 8.5 0ZM8.5 1.70341C7.15509 1.70341 5.84038 2.10222 4.72212 2.84941C3.60387 3.59661 2.73229 4.65862 2.21762 5.90116C1.70294 7.1437 1.56828 8.51095 1.83066 9.83002C2.09304 11.1491 2.74068 12.3607 3.69167 13.3117C4.64267 14.2627 5.85431 14.9104 7.17338 15.1727C8.49245 15.4351 9.85971 15.3005 11.1022 14.7858C12.3448 14.2711 13.4068 13.3995 14.154 12.2813C14.9012 11.163 15.3 9.84832 15.3 8.5034C15.3 7.61042 15.1241 6.72617 14.7824 5.90116C14.4406 5.07614 13.9398 4.32652 13.3083 3.69508C12.6769 3.06364 11.9273 2.56276 11.1022 2.22103C10.2772 1.87929 9.39299 1.70341 8.5 1.70341ZM9.35034 11.0537H10.6252V12.7572H6.37551V11.0537H7.65034V9.35034H6.37551V7.64693H9.35034V11.0537ZM9.35034 6.37823H7.64693V4.67483H9.35034V6.37823Z" fill="currentColor"/>
            </svg>

            Bekijk detials
        </button>
    </section>

</dialog>


