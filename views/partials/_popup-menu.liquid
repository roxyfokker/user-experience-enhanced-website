<dialog id="popup-menu">
    <section class="popup-header">
        <h2>Wat wil je met het isntrument doen ?</h2>
        <button class="popup-sluiten" onclick="document.getElementById('popup-menu').close()"><img src="/assets/icons/close.svg" alt=""></button>
    </section>
    <section class="popup-banner">
        {% comment %} slechte naam/div word picture {% endcomment %}
        <div class="banner-picture"></div>
        <div class="banner-text">
            <p>{{ instrument.name }}</p>
            <p>{{ instrument.serial_number | default: 'onbekend'}}</p>
        </div>

        <span class="status-label
                    {% if status == 'Beschikbaar' %}status-available
                    {% elsif status == 'In reparatie' %}status-repair
                    {% elsif status == 'Uitgeleend' or status == 'In gebruik voor school' %}status-borrowed
                    {% else %}status-unknown
                    {% endif %}
                    ">
                    {% if status == 'Beschikbaar' %}
                        Beschikbaar 
                    {% elsif status == 'In reparatie' %}
                        In Reparatie 
                    {% elsif status == 'Uitgeleend' %}
                        Uitgeleend 
                    {% elsif status == 'In gebruik voor school' %}
                        In Gebruik voor school
                    {% else %}
                        Onbekend
                    {% endif %}
        </span>
    </section>

    <section class="action-btns" role="group" aria-label="Instrumenten acties">

        {% comment %} Als instrument onbekend {% endcomment %}
        <button class="btn btn-primary" onclick="document.getElementById('toevoegen-dialog').showModal()">Instrument toevoegen</button>
            {% render 'partials/_popup-innemen.liquid' %}

        {% comment %} Als status beschikbaar {% endcomment %}
        <button class="btn btn-primary" onclick="document.getElementById('uitlenen-dialog').showModal()">Uitlenen</button>
            {% render 'partials/_popup-uitlenen.liquid' %}

        {% comment %} Als status uitgeleent {% endcomment %}
        <button class="btn btn-primary" onclick="document.getElementById('innemen-dialog').showModal()">Innemen</button>
            {% render 'partials/_popup-innemen.liquid' %}

        {% comment %} Ongeacht de status {% endcomment %}
        <button class="btn btn-secondary" onclick="document.getElementById('schade-dialog').showModal()">Schade melden</button>
            {% render 'partials/_popup-schade-melden.liquid' %}
            
        <button class="btn btn-secondary" onclick="document.getElementById('popup-menu').close()">bekijk detials</button>
    </section>

</dialog>


